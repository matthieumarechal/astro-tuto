---
import '@fontsource/inter';
import BaseLayout from './BaseLayout.astro';  

const { frontmatter } = Astro.props;
---
        
<BaseLayout pageTitle={frontmatter.title}>

    <div id="main-blog">
        <img src={frontmatter.image.url} width="100%"  alt={frontmatter.image.alt} />
        <p id="pudDate">Published on {frontmatter.pubDate.toLocaleDateString()} - </p>
        <p id="author">Written by <span class="underline">{frontmatter.author}</span></p>
        <p><em>{frontmatter.description}</em></p>

        <div class="tags">
            {frontmatter.tags.map((tag: string) => (
                <p class="tag"><a href={`/tags/${tag}`}>{tag}</a></p>
            ))}
        </div>
        
        <slot />
    </div>
</BaseLayout>

<style>
  a {
    color: var(--lila);
    text-decoration: none;
  }

  a:hover {
    color: var(--gris-clair);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
  }

  .tag {
    margin: 0.25em;
    border: solid 1px var(--lila);
    border-radius: .5em;
    padding: .5em 1em;
    font-size: 1.15em;
    background-color: var(--gris-base);
  }

</style>