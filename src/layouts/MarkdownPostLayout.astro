---
import '@fontsource/inter';
import BaseLayout from './BaseLayout.astro';  
import { imageConfig } from 'astro:assets';
import { Image } from 'astro:assets';

const { frontmatter } = Astro.props;
---
        
<BaseLayout pageTitle={frontmatter.title}>

    <div id="main-blog">
        <img src={frontmatter.image.url} width="100%"  alt={frontmatter.image.alt} />
        <p id="pudDate">Published on {frontmatter.pubDate.toString().slice(0,10)} - </p>
        <p id="author">Written by <span class="underline">{frontmatter.author}</span></p>
        <p><em>{frontmatter.description}</em></p>
        
        <slot />
    </div>
</BaseLayout>